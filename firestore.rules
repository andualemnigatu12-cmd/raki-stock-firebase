rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return profileExists() && userProfile().data.active == true;
    }

    function isOwner() {
      return activeUser() && userProfile().data.role == 'owner';
    }

    function sameBranch(branchId) {
      return activeUser() && userProfile().data.branchId == branchId;
    }

    function ownerBootstrap(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'owner'
        && request.resource.data.active == true
        && request.resource.data.branchId == 'raki-bale-robe'
        && getAfter(/databases/$(database)/documents/branches/raki-bale-robe).data.ownerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId
          || (isOwner() && resource.data.branchId == userProfile().data.branchId));

      allow create: if ownerBootstrap(userId)
        || (isOwner()
          && request.resource.data.branchId == userProfile().data.branchId);

      allow update: if (isOwner()
          && resource.data.branchId == userProfile().data.branchId
          && request.resource.data.branchId == resource.data.branchId)
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.branchId == resource.data.branchId
          && request.resource.data.active == resource.data.active);

      allow delete: if false;
    }

    match /branches/{branchId} {
      allow read: if sameBranch(branchId);

      allow create: if signedIn()
        && branchId == 'raki-bale-robe'
        && !exists(/databases/$(database)/documents/branches/$(branchId))
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isOwner()
        && sameBranch(branchId)
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if sameBranch(resource.data.branchId);

      // Old test records can still be read, but all NEW writes must carry a
      // valid positive selling price and nonnegative integer quantity.
      allow create: if isOwner()
        && request.resource.data.branchId == userProfile().data.branchId
        && request.resource.data.sellingPrice is number
        && request.resource.data.sellingPrice > 0
        && request.resource.data.stockQty is int
        && request.resource.data.stockQty >= 0;

      allow update: if isOwner()
        && resource.data.branchId == userProfile().data.branchId
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.sellingPrice is number
        && request.resource.data.sellingPrice > 0
        && request.resource.data.stockQty is int
        && request.resource.data.stockQty >= 0;

      // Protect approved V2 product history from accidental deletion.
      allow delete: if isOwner()
        && resource.data.branchId == userProfile().data.branchId
        && resource.data.get('schemaVersion', 1) != 2;
    }


    // V2 captures are append-only for staff. Employees cannot set price,
    // approve an entry, or modify official inventory quantities.
    match /registration_entries/{entryId} {
      allow read: if sameBranch(resource.data.branchId);

      allow create: if signedIn()
        && sameBranch(request.resource.data.branchId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.schemaVersion == 2
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 1000000
        && request.resource.data.nameCandidate is string
        && request.resource.data.barcodeCandidate is string
        && request.resource.data.productText is string
        && request.resource.data.section is string
        && request.resource.data.photoState in ['local_only', 'none']
        && request.resource.data.keys().hasOnly([
          'branchId', 'createdBy', 'quantity', 'nameCandidate',
          'barcodeCandidate', 'productText', 'section', 'photoState',
          'localPhotoPath', 'status', 'createdAt', 'schemaVersion'
        ]);

      allow update: if (isOwner()
        && sameBranch(resource.data.branchId)
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.quantity == resource.data.quantity
        && resource.data.status == 'pending'
        && (
          (request.resource.data.status == 'approved'
            && request.resource.data.reviewedName is string
            && request.resource.data.reviewedName.size() > 0
            && request.resource.data.reviewedSellingPrice is number
            && request.resource.data.reviewedSellingPrice > 0
            && request.resource.data.linkedProductId is string
            && request.resource.data.linkedProductId.size() > 0
            && request.resource.data.approvedBy == request.auth.uid)
          ||
          (request.resource.data.status == 'rejected'
            && request.resource.data.reviewedBy == request.auth.uid)
        ))
        || (signedIn()
          && sameBranch(resource.data.branchId)
          && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'nameCandidate', 'barcodeCandidate', 'productText'
            ]));

      allow delete: if false;
    }

    // Every approved V2 registration creates one immutable stock movement.
    match /inventory_movements/{movementId} {
      allow read: if sameBranch(resource.data.branchId);
      allow create: if isOwner()
        && sameBranch(request.resource.data.branchId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.registrationEntryId == movementId
        && request.resource.data.productId is string
        && request.resource.data.type == 'opening_count'
        && request.resource.data.quantityDelta is int
        && request.resource.data.quantityDelta > 0
        && request.resource.data.beforeQty is int
        && request.resource.data.afterQty ==
          request.resource.data.beforeQty + request.resource.data.quantityDelta;
      allow update, delete: if false;
    }

    match /stock_count_sessions/{sessionId} {
      allow read: if sameBranch(resource.data.branchId);

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && sameBranch(request.resource.data.branchId);

      allow update: if sameBranch(resource.data.branchId)
        && request.resource.data.branchId == resource.data.branchId
        && (isOwner() || resource.data.createdBy == request.auth.uid);

      allow delete: if isOwner() && sameBranch(resource.data.branchId);

      match /items/{itemId} {
        // Count items carry their own immutable branchId. Reading/writing by
        // that branch avoids a race where a newly-created parent session is
        // still syncing while the employee already captures the first item.
        allow read: if sameBranch(resource.data.branchId);

        allow create: if signedIn()
          && request.resource.data.createdBy == request.auth.uid
          && sameBranch(request.resource.data.branchId);

        allow update: if sameBranch(resource.data.branchId)
          && request.resource.data.branchId == resource.data.branchId
          && (isOwner() || resource.data.createdBy == request.auth.uid);

        allow delete: if isOwner() && sameBranch(resource.data.branchId);
      }
    }
  }
}
